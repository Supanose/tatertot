<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/w_tater"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Tater"
            android:src="@drawable/tater_awake" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Baby · Awake"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp" />

                <Chronometer
                    android:id="@+id/w_elapsed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_main"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Next nap ~10:45"
                android:textColor="@color/widget_text"
                android:textSize="21sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/w_range"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Likely 10:35–10:55"
                android:textColor="@color/widget_muted"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/w_settle_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/w_settle_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:text="Start settling in "
                    android:textColor="@color/widget_highlight"
                    android:textSize="14sp" />

                <Chronometer
                    android:id="@+id/w_settle_chrono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/widget_highlight"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/w_toggle"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="2"
            android:background="@drawable/widget_btn_primary"
            android:text="Asleep"
            android:textAllCaps="false"
            android:textColor="@color/widget_on_accent"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/w_feed"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:background="@drawable/widget_btn_secondary"
            android:text="Feed"
            android:textAllCaps="false"
            android:textColor="@color/widget_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
